{
  "name": "fjord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:benchmark-report": "node --test scripts/report-benchmark-deltas.node-test.mjs",
    "check-i18n": "node scripts/check-i18n.ts",
    "check-ipc-docs": "node scripts/check-ipc-docs.ts",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:start": "node scripts/release-start.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test:release-verify": "node --test scripts/release-verify.node-test.mjs",
    "test:release-prepare": "node --test scripts/release-prepare.node-test.mjs scripts/release-start.node-test.mjs",
    "audit:public": "node scripts/audit-public-repo.mjs",
    "check:release-notes": "node scripts/check-release-notes.mjs",
    "test:release-notes": "node --test scripts/check-release-notes.node-test.mjs",
    "test:apple-signing": "node --test scripts/apple-signing-lib.node-test.mjs scripts/apple-signing-mode.node-test.mjs",
    "test:updater-manifest": "node --test scripts/updater-manifest-lib.node-test.mjs scripts/verify-updater-manifest.node-test.mjs",
    "test:release-workflow": "node --test scripts/release-workflow-signing.node-test.mjs",
    "test:release-discovery": "node --test scripts/release-discovery-lib.node-test.mjs scripts/github-releases-client.node-test.mjs scripts/resolve-release-by-tag.node-test.mjs scripts/check-release-candidate.node-test.mjs",
    "gate:v0.1": "node scripts/evaluate-v0.1-launch-gate.mjs",
    "test:launch-gate": "node --test scripts/evaluate-v0.1-launch-gate.node-test.mjs",
    "prepare:askpass": "node scripts/prepare-askpass-sidecar.mjs",
    "tauri:build": "cargo build --release -p fjord-askpass && npm run prepare:askpass && tauri build --config src-tauri/tauri.sidecar.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
